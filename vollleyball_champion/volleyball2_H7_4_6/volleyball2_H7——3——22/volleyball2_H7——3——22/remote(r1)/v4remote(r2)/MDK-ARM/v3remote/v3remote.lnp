"v3remote\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "v3remote\v3remote.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "v3remote.map" -o v3remote\v3remote.axf