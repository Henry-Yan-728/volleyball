--cpu Cortex-M3
"v3remote\startup_stm32f103xe.o"
"v3remote\main.o"
"v3remote\gpio.o"
"v3remote\adc.o"
"v3remote\dma.o"
"v3remote\tim.o"
"v3remote\usart.o"
"v3remote\stm32f1xx_it.o"
"v3remote\stm32f1xx_hal_msp.o"
"v3remote\crc.o"
"v3remote\stm32f1xx_hal_gpio_ex.o"
"v3remote\stm32f1xx_hal_adc.o"
"v3remote\stm32f1xx_hal_adc_ex.o"
"v3remote\stm32f1xx_hal.o"
"v3remote\stm32f1xx_hal_rcc.o"
"v3remote\stm32f1xx_hal_rcc_ex.o"
"v3remote\stm32f1xx_hal_gpio.o"
"v3remote\stm32f1xx_hal_dma.o"
"v3remote\stm32f1xx_hal_cortex.o"
"v3remote\stm32f1xx_hal_pwr.o"
"v3remote\stm32f1xx_hal_flash.o"
"v3remote\stm32f1xx_hal_flash_ex.o"
"v3remote\stm32f1xx_hal_exti.o"
