{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H723 (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "serverpath": "D:/robocon/DevEnv/DevEnv/openocd-v0.12.0-i686-w64-mingw32/bin/openocd.exe",
      "searchDir": [
        "D:/robocon/DevEnv/DevEnv/openocd-v0.12.0-i686-w64-mingw32/share/openocd/scripts"
      ],
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32h7x.cfg"
      ],
      "openOCDLaunchCommands": [
        "cmsis_dap_backend hid",
        "transport select swd",
        "adapter speed 1000"
      ],
      "armToolchainPath": "F:/STM32/STM32CubeCLT_1.19.0/GNU-tools-for-STM32/bin",
      "gdbPath": "F:/STM32/STM32CubeCLT_1.19.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
      "executable": "${workspaceFolder}/build/Debug/volleyball2_H7.elf",
      "device": "STM32H723xx",
      "runToEntryPoint": "main",
      "preLaunchTask": "CMake: Build (Debug)"
    }
  ]
}
